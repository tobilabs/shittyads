# Cloudflare R2 (S3-kompatibel)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shittyads
# Öffentliche URL des Buckets (Custom Domain oder r2.dev URL)
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Optionaler Upload-Schutz
UPLOAD_SECRET=

# Pfad zur SQLite-Datenbank (Default: ./data/ads.db)
DB_PATH=./data/ads.db
